# Modelo de configuração local. Copie para ".env" (que NÃO é versionado) e ajuste.
# Todos os valores abaixo são fictícios/explicativos. Nunca coloque credenciais reais neste arquivo.

# String de conexão JDBC do banco.
# Local (H2 em arquivo, os dados sobrevivem ao reinício da aplicação):
DATABASE_URL=jdbc:h2:file:./dados/agenda;DB_CLOSE_DELAY=-1
# Exemplo PostgreSQL (exige trocar a dependência h2 pelo driver no pom.xml):
# DATABASE_URL=jdbc:postgresql://<servidor>:5432/<banco>

# Usuário e senha do banco (no H2 local o padrão é usuário "sa" sem senha).
DATABASE_USER=sa
DATABASE_PASSWORD=

# Liga o console web do H2 em http://localhost:8080/h2-console (somente em desenvolvimento).
H2_CONSOLE_ENABLED=true

# Porta HTTP da aplicação.
PORT=8080
